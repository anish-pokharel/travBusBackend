
NODE_ENV=development
# FRONTEND_DIST=/custom/path/to/frontend/dist/browser   (optional; default is ../frontend/dist/frontend/browser)
PORT=5001

# MongoDB Atlas connection string (put the real value only in .env, never commit it)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Bus_Lam
MONGODB_URI=mongodb+srv://anish:anish@cluster0.xuf0z19.mongodb.net/Bus_Lam

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=034ac4c43219e84b6baa8d16e58768b03ebf8406faa0cf0567979f067d205538950016f27a8188ebee17e0c6b63c6b36
JWT_REFRESH_SECRET=b7e6a8bf17a71632edd6ea93059290ea3925a853c7d2df724cef8ade08b8811f3ba09648a3135e224a6f6ca7d67724f5
TICKET_SECRET=a2d1280b7401e6407287d650cca25a6a4ac289bcba884b2c88ba18093061f0bfdf4a38c2e4254d1e6e6a1a8c02b5cd24
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# Cookie settings for the refresh token.
# Same-site hosting: lax. Frontend and API on different domains: none (requires HTTPS).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Seat hold time in minutes
SEAT_HOLD_MINUTES=10

# First admin created by `npm run seed` (change the password immediately after first login)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@12345

# Payment gateways (sandbox). Get real keys from the providers.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
